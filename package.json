{
  "name": "nexsanity",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Next.js and Sanity template for SaaS and studio websites, edited entirely from Sanity Studio.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "typegen": "sanity schema extract --path sanity/schema.json --enforce-required-fields --force && sanity typegen generate",
    "seed:generate": "node seed/generate-demo-content.ts",
    "seed:import": "sanity dataset import seed/demo-content.ndjson --dataset production --replace"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@number-flow/react": "^0.6.2",
    "@sanity/client": "^8.9.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.17.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-sanity": "^13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.0",
    "sanity": "^6.17.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unicorn": "65.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
